{
  "name": "@rrflow/rrd-client",
  "version": "1.0.0",
  "description": "Supported TypeScript client for the RRFlow Durable Runtime v1 API",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/generated/rrd-openapi.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm generate:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "arktype": "2.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
