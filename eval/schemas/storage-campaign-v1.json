    "ClockPolicy": {
      "additionalProperties": false,
      "description": "Policy for wall-clock observations at governed durable-effect boundaries.\n\nA value of zero is strict: any observed rollback from a persisted anchor is\nrejected. A nonzero value is an explicit operator-selected allowance, not\nevidence that the host clock is synchronized or trustworthy.",
      "properties": {
