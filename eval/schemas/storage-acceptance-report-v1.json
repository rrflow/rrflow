{
  "$defs": {
    "AcceptanceSource": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "public_catalogue_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "tree": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "public_catalogue_sha256"
      ],
      "type": "object"
    },
    "AcceptedOperatingPoint": {
      "additionalProperties": false,
      "properties": {
        "absence_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "clients": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "directory": {
          "$ref": "#/$defs/Id"
        },
        "evidence_verified": {
          "type": "boolean"
        },
        "launch_cleanup_confirmed": {
          "type": "boolean"
        },
        "launch_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "launch_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CampaignStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "$ref": "#/$defs/NativePlatform"
        },
        "profile": {
          "$ref": "#/$defs/Id"
        },
        "qualification_passed": {
          "type": "boolean"
        },
        "requests_per_second": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/CampaignStatus"
        }
      },
      "required": [
        "directory",
        "profile",
        "platform",
        "clients",
        "requests_per_second",
        "status",
        "qualification_passed",
        "evidence_verified",
        "launch_cleanup_confirmed"
      ],
      "type": "object"
    },
    "CampaignStatus": {
      "enum": [
        "completed",
        "failed",
        "interrupted",
        "not_run"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "type": "string"
    },
    "LatencyBounds": {
      "additionalProperties": false,
      "properties": {
        "lower_ns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "upper_ns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "samples",
        "lower_ns",
        "upper_ns"
      ],
      "type": "object"
    },
    "Limit": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "NativePlatform": {
      "enum": [
        "linux_ext4",
        "macos_apfs",
        "windows_ntfs"
      ],
      "type": "string"
    },
    "NominalObservation": {
      "additionalProperties": false,
      "properties": {
        "clients": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "directory": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/StorageLoadKind"
        },
        "maximum_error_basis_points": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_p95_ns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_p99_ns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p95": {
          "$ref": "#/$defs/LatencyBounds"
        },
        "p99": {
          "$ref": "#/$defs/LatencyBounds"
        },
        "passed": {
          "type": "boolean"
        },
        "point": {
          "$ref": "#/$defs/Id"
        },
        "profile": {
          "$ref": "#/$defs/Id"
        },
        "requests_per_second": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "terminal_errors": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_attempts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "directory",
        "profile",
        "point",
        "clients",
        "requests_per_second",
        "seed",
        "kind",
        "p95",
        "p99",
        "total_attempts",
        "terminal_errors",
        "maximum_p95_ns",
        "maximum_p99_ns",
        "maximum_error_basis_points",
        "passed"
      ],
      "type": "object"
    },
    "ProfileCoverage": {
      "additionalProperties": false,
      "properties": {
        "attempted_points": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "largest_qualified_rate": {
          "description": "Largest actually qualified rate; zero means no qualified observation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing_coordinates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/Id"
        },
        "qualified_envelopes": {
          "items": {
            "$ref": "#/$defs/QualifiedEnvelope"
          },
          "type": "array"
        },
        "qualified_points": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "attempted_points",
        "qualified_points",
        "missing_coordinates",
        "largest_qualified_rate",
        "qualified_envelopes"
      ],
      "type": "object"
    },
    "QualifiedEnvelope": {
      "additionalProperties": false,
      "properties": {
        "clients": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_tested_rate": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "clients",
        "maximum_tested_rate"
      ],
      "type": "object"
    },
    "StorageLoadKind": {
      "enum": [
        "point_read",
        "range_read",
        "mixed_write",
        "maintenance"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_ci_passed": {
      "type": "boolean"
    },
    "capacity_qualified": {
      "type": "boolean"
    },
    "ci_run_attempt": {
      "$ref": "#/$defs/Limit"
    },
    "ci_run_id": {
      "$ref": "#/$defs/Limit"
    },
    "format_version": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/Digest"
    },
    "matrix_complete": {
      "type": "boolean"
    },
    "nominal_observations": {
      "items": {
        "$ref": "#/$defs/NominalObservation"
      },
      "maxItems": 1536,
      "type": "array"
    },
    "nominal_thresholds_passed": {
      "type": "boolean"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/AcceptedOperatingPoint"
      },
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileCoverage"
      },
      "type": "array"
    },
    "ready_for_owner_review": {
      "description": "Conservative evidence readiness, not an automatic C-07/alpha status change.",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/AcceptanceSource"
    }
  },
  "required": [
    "format_version",
    "manifest_sha256",
    "source",
    "ci_run_id",
    "ci_run_attempt",
    "candidate_ci_passed",
    "points",
    "profiles",
    "matrix_complete",
    "capacity_qualified",
    "nominal_thresholds_passed",
    "nominal_observations",
    "ready_for_owner_review"
  ],
  "title": "StorageAcceptanceReport",
  "type": "object"
}
